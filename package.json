{
  "name": "blog-ia-nodejs",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --watch src/index.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "prepare": "lefthook install",
    "test": "node --test src/**/*.test.ts",
    "env:setup": "cp .env.example .env.local",
    "local:setup": "npm run env:setup && npm run infra:up && npm run db:migrate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "node --env-file=.env.local ./node_modules/postgrator-cli/index.js",
    "db:migrate:undo": "node --env-file=.env.local ./node_modules/postgrator-cli/index.js 0",
    "db:migrate:to": "node --env-file=.env.local ./node_modules/postgrator-cli/index.js"
  },
  "dependencies": {
    "@mastra/core": "^1.82.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "postgrator-cli": "^10.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts,mjs,cjs}": "oxlint --fix --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24"
  }
}
